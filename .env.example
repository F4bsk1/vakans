# Copy to .env (gitignored) and edit. Every value here is a local-dev default.
#
# NEVER put a real patient phone number in this file or in .env. The only real number that
# may ever appear is VAKANS_FOUNDER_MOBILE — your own phone, the demo's "JA-svararen".

VAKANS_ENV=local

# --- database ---------------------------------------------------------------------------
# Local Docker Postgres (make db-up). For Supabase EU, replace with the Frankfurt pooler URL:
# postgres:// and postgresql:// are both accepted and normalised, and sslmode=require is
# appended automatically for non-local hosts.
VAKANS_DATABASE_URL=postgresql+psycopg://vakans:vakans@localhost:55432/vakans
VAKANS_DB_ECHO=false

# --- LLM --------------------------------------------------------------------------------
# Ingestion extraction ONLY. This reads public clinic web pages, not patient data, so the
# provider choice here is not the EU-posture decision — that one is on the voice path.
#
# "fake" needs no credentials and is what the whole test suite runs on. Switch to a real
# provider only when you are tuning the ingestion extraction prompt.
#
# Pick a provider and a matching model id:
#   mistral    mistral-small-latest        cheapest, EU-native, minutes to a key
#   anthropic  claude-haiku-4-5            fast and cheap; supports structured outputs
#              claude-sonnet-5             stronger extraction
#              claude-opus-5               strongest
#   azure      gpt-4.1                     the charter's production choice (needs approval)
#   openai     gpt-4.1
VAKANS_LLM_PROVIDER=fake
VAKANS_LLM_MODEL=gpt-4.1
# VAKANS_MISTRAL_API_KEY=
# VAKANS_ANTHROPIC_API_KEY=
# VAKANS_OPENAI_API_KEY=
# VAKANS_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# VAKANS_AZURE_OPENAI_API_KEY=
# VAKANS_AWS_REGION=eu-north-1

# --- SMS + the refill cascade (step 3) ------------------------------------------------------
# `fake` writes every message to the API log instead of sending it. The whole cascade works on
# it, so you can rehearse the demo with no 46elks account and no phone in the room.
VAKANS_SMS_PROVIDER=fake
VAKANS_SMS_SENDER_ID=Vakans
# Your own mobile, E.164. This is the ONE number the refill cascade is allowed to really text.
VAKANS_FOUNDER_MOBILE=+46700000000
# VAKANS_ELKS_USERNAME=
# VAKANS_ELKS_PASSWORD=
#
# With a real 46elks number, point its inbound SMS webhook at:
#   https://<your-tunnel>/sms/<clinic_id>/inbound?token=<VAKANS_AGENT_TOKEN>
# 46elks cannot send custom headers, hence the query-string token. See app/routers/sms.py.

# Spec §3: "Timeout 90 s → nästa kandidat". Drop it to ~30 if the silence drags on stage.
VAKANS_REFILL_OFFER_TIMEOUT_S=90
# The background loop that delivers queued SMS and advances timed-out cascades. Turning it off
# means offers are sent but never expire — the cascade stops after candidate #1.
VAKANS_REFILL_WORKER_ENABLED=true
VAKANS_REFILL_WORKER_INTERVAL_S=5.0

# --- demo sandbox ---------------------------------------------------------------------------
VAKANS_SEED_RNG_SEED=20260907
# Required outside env=local: /sim/* is destructive and expects X-Demo-Token.
# VAKANS_DEMO_TOKEN=

# --- dashboard (step 5) -----------------------------------------------------------------------
# Origins the Next.js dashboard is served from. Explicit rather than "*": /sim/* is destructive
# and reachable from a browser, so any page should not be able to reset a demo mid-meeting.
VAKANS_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ingestion ------------------------------------------------------------------------------
VAKANS_CRAWL_MAX_PAGES=40
VAKANS_CRAWL_MAX_DEPTH=2
VAKANS_CRAWL_RESPECT_ROBOTS=true

# --- voice agent (charter D1: ElevenLabs Agents) --------------------------------------------
# REQUIRED. /agent/* is reachable from the internet whenever a tunnel is running, and
# unauthenticated it lets anyone who finds the URL read a calendar or cancel appointments.
# Generate with: openssl rand -hex 32
# VAKANS_AGENT_TOKEN=
# The agent's id, so `elevenlabs/agents.json` makes their CLI update rather than create a
# second agent. You get it from `elevenlabs agents add ... --from-file`, or from the dashboard
# URL. Deploying uses ELEVENLABS_API_KEY (no VAKANS_ prefix) which their CLI reads itself.
# VAKANS_ELEVENLABS_AGENT_ID=
# Which model runs the conversation. Sonnet is the balance between reasoning and latency; try
# claude-haiku-4-5 if turns feel slow, claude-opus-4-7 if the agent feels stupid.
VAKANS_ELEVENLABS_LLM=claude-sonnet-4-5
# Your ngrok/cloudflared URL — where ElevenLabs reaches this API.
VAKANS_PUBLIC_BASE_URL=http://localhost:8000
